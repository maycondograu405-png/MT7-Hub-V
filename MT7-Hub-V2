local function CreatePROButton(title, stateName)

    return CreateButton(
        "🔒 " .. title .. " [PRO]",
        function(button)

            if not IsPRO or not PRO then

                Status.Text =
                    "🔒 PRO bloqueado • valide sua Key"

                Status.TextColor3 =
                    Color3.fromRGB(255, 180, 80)

                return

            end

            local newState =
                not PRO.States[stateName]

            PRO.Set(
                stateName,
                newState
            )

            UpdateButton(
                button,
                title,
                newState,
                false
            )

            Status.Text =
                "💎 PRO • " ..
                title ..
                " [" ..
                (newState and "ON" or "OFF") ..
                "]"

            Status.TextColor3 =
                Theme.Light

        end
    )

end

