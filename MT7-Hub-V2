local function LoadPRO()

    if PRO then
        return true
    end

    local success, result = pcall(function()

        local source = game:HttpGet(PRO_URL)

        return loadstring(source)()

    end)

    if success and type(result) == "table" then

        PRO = result
        IsPRO = true

        return true

    end

    warn("MT7: erro ao carregar MT7PRO.lua")

    return false

end

