        Color3.fromRGB(230, 235, 245)

    Button.AutoButtonColor = false

    Corner(Button, 9)

    AddStroke(
        Button,
        Theme.Main,
        1
    )

    Button.MouseButton1Click:Connect(
        function()
            callback(Button)
        end
    )

    return Button

end

local function UpdateButton(
    button,
    title,
    state,
    locked
)

    if locked then

        button.Text =
            "🔒 " .. title .. " [PRO]"

    else

        button.Text =
            title ..
            " [" ..
            (state and "ON" or "OFF") ..
            "]"

    end

end

